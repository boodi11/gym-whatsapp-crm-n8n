    {
      "parameters": {
        "jsCode": "const eligibleMembers = [];\nfor (let item of $input.all()) {\n  const visits = parseInt(item.json['Visits_This_Month']) || 0;\n  const reviewAsked = item.json['Review_Asked'];\n  if (visits >= 12 && reviewAsked !== 'TRUE' && reviewAsked !== true && reviewAsked !== 'Yes') {\n    eligibleMembers.push(item);\n  }\n}\nreturn eligibleMembers;"
      },
      "name": "Filter >= 12 Visits & Not Asked",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
