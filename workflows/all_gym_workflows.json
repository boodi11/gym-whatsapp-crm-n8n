        "parameters": {
          "jsCode": "function parseDateStr(d) {\n  if (!d) return new Date(NaN);\n  if (typeof d === 'number') { return new Date((d - 25569) * 86400 * 1000); }\n  const s = String(d).trim().split(' ')[0];\n  const dm = s.match(/^(\\d{1,2})[\\/\\-](\\d{1,2})[\\/\\-](\\d{4})$/);\n  if (dm) return new Date(dm[3], dm[2]-1, dm[1]);\n  const ym = s.match(/^(\\d{4})[\\/\\-](\\d{1,2})[\\/\\-](\\d{1,2})$/);\n  if (ym) return new Date(ym[1], ym[2]-1, ym[3]);\n  return new Date(d);\n}\nconst todayStr = new Date().toLocaleString(\"en-US\", { timeZone: \"Africa/Cairo\" });\nconst today = new Date(todayStr);\ntoday.setHours(0,0,0,0);\n\nfor (let item of $input.all()) {\n  let joinDateStr = null;\n  for (let key in item.json) {\n    if (key.trim().toLowerCase() === 'join date' || key.trim().toLowerCase() === 'joined date') { joinDateStr = item.json[key]; break; }\n  }\n  const joinDateParsed = parseDateStr(joinDateStr);\n  if (!isNaN(joinDateParsed.getTime())) {\n    const joinDate = new Date(joinDateParsed.toLocaleString(\"en-US\", { timeZone: \"Africa/Cairo\" }));\n    joinDate.setHours(0,0,0,0);\n    item.json['Days Since Joined'] = Math.round((today.getTime() - joinDate.getTime()) / (1000 * 3600 * 24));\n  } else { item.json['Days Since Joined'] = -1; }\n}\nreturn $input.all();"
        },
