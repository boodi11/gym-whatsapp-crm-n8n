        "parameters": {
          "jsCode": "function parseDateStr(d) {\n  if (!d) return new Date(NaN);\n  if (typeof d === 'number') { return new Date((d - 25569) * 86400 * 1000); }\n  const s = String(d).trim().split(' ')[0];\n  const dm = s.match(/^(\\d{1,2})[\\/\\-](\\d{1,2})[\\/\\-](\\d{4})$/);\n  if (dm) return new Date(dm[3], dm[2]-1, dm[1]);\n  const ym = s.match(/^(\\d{4})[\\/\\-](\\d{1,2})[\\/\\-](\\d{1,2})$/);\n  if (ym) return new Date(ym[1], ym[2]-1, ym[3]);\n  return new Date(d);\n}\nconst todayStr = new Date().toLocaleString(\"en-US\", { timeZone: \"Africa/Cairo\" });\nconst today = new Date(todayStr);\ntoday.setHours(0,0,0,0);\n\nconst targetDays = [45, 48, 50];\nconst expiredMembers = [];\nfor (let item of $input.all()) {\n  const expiryParsed = parseDateStr(item.json['Expiry Date']);\n  if (!isNaN(expiryParsed.getTime())) {\n    const expiryDate = new Date(expiryParsed.toLocaleString(\"en-US\", { timeZone: \"Africa/Cairo\" }));\n    expiryDate.setHours(0,0,0,0);\n    if (expiryDate.getTime() < today.getTime()) {\n      const diffDays = Math.round((today.getTime() - expiryDate.getTime()) / (1000 * 3600 * 24));\n      if (targetDays.includes(diffDays)) { item.json['Days Since Expiry'] = diffDays; expiredMembers.push(item); }\n    }\n  }\n}\nreturn expiredMembers;"
        },
