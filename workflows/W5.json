    {
      "parameters": {
        "jsCode": "const eligibleMembers = [];\nfor (let item of $input.all()) {\n  const visits = parseInt(item.json['Visits_This_Month'] || item.json['Total Visits']) || 0;\n  const referralAsked = item.json['Referral_Asked'];\n  if (visits >= 10 && referralAsked !== 'TRUE' && referralAsked !== true && referralAsked !== 'Yes') {\n    eligibleMembers.push(item);\n  }\n}\nreturn eligibleMembers;"
      },
      "name": "Filter >= 10 Visits & Not Asked",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
